<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="40dp"
    tools:context=".OrderConfirmation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/successIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/checkmark_100"
            android:contentDescription="Success Icon" />

        <TextView
            android:id="@+id/tvConfirmationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/tiltwarp"
            android:text="Order\nConfirmation!"
            android:textAlignment="center"
            android:textColor="@color/green"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfirmationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:alpha="0.6"
            android:fontFamily="@font/tiltwarp"
            android:text="Your order has been placed successfully!\nWe'll notify you when it's on the way."
            android:textAlignment="center"
            android:textColor="@color/green"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/green"
            android:fontFamily="@font/tiltwarp"
            android:text="Rate"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="15dp" />

        <Button
            android:id="@+id/btnOrderAgain"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/tiltwarp"
            android:text="Order Again"
            android:textAllCaps="false"
            android:textColor="@color/green"
            android:textSize="16sp"
            app:cornerRadius="15dp"
            app:strokeColor="@color/green"
            app:strokeWidth="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>